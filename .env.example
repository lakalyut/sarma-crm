DOMAIN=example.com

POSTGRES_DB=sarma
POSTGRES_USER=sarma
POSTGRES_PASSWORD=change_me

APP_SECRET_KEY=change_me

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Горизонт 13 (амбассадорский Telegram-бот), Этап 0 — токен тестового бота от @BotFather
TELEGRAM_TOKEN=change_me
# Этап 2 — секрет для X-Telegram-Bot-Api-Secret-Token, задаётся при setWebhook
TELEGRAM_WEBHOOK_SECRET=change_me
# Исходящий HTTPS к api.telegram.org с прод-VPS заблокирован на уровне сети —
# обе переменные ниже опциональны локально (по умолчанию идёт напрямую на
# api.telegram.org), но обязательны на бою, если используется релей через
# Cloudflare Worker (deploy/telegram_relay_worker.js, см. CLAUDE.md/Deploy).
# TELEGRAM_API_BASE_URL=https://<имя-воркера>.<аккаунт>.workers.dev
# TELEGRAM_RELAY_SECRET=change_me
# Блокировка оказалась симметричной — Telegram тоже не может достучаться ДО
# нас (вебхук не доставляется), поэтому в проде бот работает через long
# polling (app/telegram_poller.py), не через POST /telegram/webhook. Явный
# флаг — не просто по наличию TELEGRAM_TOKEN, тесты держат фиктивный токен
# в окружении постоянно (tests/conftest.py), без флага заводили бы фоновый
# поток на каждый прогон pytest.
# TELEGRAM_POLLING_ENABLED=1
# Базовый URL для ссылки на мини-апп в сообщениях бота (Открыть -> кнопка
# меню чата); по умолчанию https://sarma-crm.ru, переопределять только если
# домен вдруг поменяется.
# PUBLIC_BASE_URL=https://sarma-crm.ru
